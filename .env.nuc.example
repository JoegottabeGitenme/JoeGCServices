# =============================================================================
# Weather WMS - Production Deployment Configuration
# =============================================================================
# Copy to .env.nuc and customize for your deployment.
#
# Usage:
#   cp .env.nuc.example .env.nuc
#   # Edit .env.nuc with your values (REMOTE_HOST, DOMAIN, etc.)
#   ./scripts/deploy-remote.sh
#
# Passwords left blank will be auto-generated on first deploy and saved
# back to this file for future reference.
# =============================================================================

# =============================================================================
# SECTION 1: REMOTE SERVER ACCESS
# =============================================================================
REMOTE_HOST=user@ip           # SSH target (user@hostname or user@ip)
REMOTE_DIR=/opt/weather-wms             # Deployment directory on remote
SSH_KEY_PATH=~/.ssh/private_key             # Path to SSH private key

# =============================================================================
# SECTION 2: DOMAIN & TLS (Let's Encrypt)
# =============================================================================
DOMAIN=example.com                  # Your domain

# =============================================================================
# SECTION 3: SECURITY & AUTHENTICATION
# =============================================================================
# Leave passwords BLANK for auto-generation on first deploy.
# Generated values will be saved back to this file.

# --- Basic Auth (protects: dashboard, Grafana, MinIO, downloader status) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- PostgreSQL ---
POSTGRES_USER=weatherwms
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO (S3-compatible storage) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=weather-data
S3_REGION=us-east-1

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# SECTION 4: RATE LIMITING
# =============================================================================
# Applied to public endpoints (WMS, WMTS, EDR APIs)
RATE_LIMIT_PER_MINUTE=10000               # Requests per minute per IP
RATE_LIMIT_BURST=500                     # Burst allowance

# =============================================================================
# SECTION 5: PERFORMANCE TUNING
# =============================================================================
# Optimized for: 20 cores, 32GB RAM, 1TB NVMe

# --- Runtime ---
TOKIO_WORKER_THREADS=16                 # Async runtime threads
DATABASE_POOL_SIZE=50                   # PostgreSQL connection pool

# --- L1 In-Memory Tile Cache ---
ENABLE_L1_CACHE=true
TILE_CACHE_SIZE_MB=8192                 # 8GB for rendered tiles
TILE_CACHE_TTL_SECS=600                 # 10 min TTL

# --- Zarr Chunk Cache ---
ENABLE_CHUNK_CACHE=true
CHUNK_CACHE_SIZE_MB=8192                # 8GB for decompressed chunks

# --- Tile Prefetching ---
ENABLE_PREFETCH=true
PREFETCH_RINGS=2
PREFETCH_MIN_ZOOM=3
PREFETCH_MAX_ZOOM=12

# --- Cache Warming ---
ENABLE_CACHE_WARMING=true
CACHE_WARMING_MAX_ZOOM=4
CACHE_WARMING_HOURS=0
CACHE_WARMING_LAYERS=gfs_TMP:temperature
CACHE_WARMING_CONCURRENCY=8

# --- Memory Pressure Management ---
ENABLE_MEMORY_PRESSURE=true
MEMORY_LIMIT_MB=28000                   # 28GB (leaving 4GB for OS/Docker)
MEMORY_PRESSURE_THRESHOLD=0.80
MEMORY_PRESSURE_TARGET=0.70

# =============================================================================
# SECTION 6: LOGGING & BUILD
# =============================================================================
RUST_LOG=info                           # info for production
RUST_BACKTRACE=0                        # Disabled in production
CARGO_PROFILE=release                   # Always release builds

# =============================================================================
# SECTION 7: MONITORING
# =============================================================================
PROMETHEUS_RETENTION_DAYS=30            # Metrics retention

# =============================================================================
# SECTION 8: EARTHDATA (NASA GES DISC - NLDAS-2 downloads)
# =============================================================================
# Register at https://urs.earthdata.nasa.gov/
# Then authorize "NASA GESDISC DATA ARCHIVE" in your Earthdata profile.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# =============================================================================
# SECTION 9: DYNAMIC DNS (for Starlink/dynamic IP)
# =============================================================================
# If your home IP changes, enable DDNS to keep your domain updated.
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Create a token with "Zone:DNS:Edit" permission for your domain.

CLOUDFLARE_API_TOKEN=                   # Cloudflare API token (Zone:DNS:Edit)
ENABLE_DDNS=true                        # Set to false if you have a static IP
CLOUDFLARE_TUNNEL_TOKEN=
