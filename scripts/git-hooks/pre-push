#!/usr/bin/env bash
#
# Git pre-push hook
#
# Validates configuration files before pushing to remote.
# This ensures broken configs don't make it into the repository.
#
# Install:
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Or use the install script:
#   ./scripts/install-git-hooks.sh
#

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If running from .git/hooks, find project root
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi

echo -e "${BLUE}Running pre-push validation...${NC}"
echo ""

FAILED=0

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo -e "${RED}Error: python3 is required for config validation${NC}"
    exit 1
fi

# Check if PyYAML is available
if ! python3 -c "import yaml" 2>/dev/null; then
    echo -e "${YELLOW}Warning: PyYAML not installed, skipping YAML validation${NC}"
    echo "Install with: pip install pyyaml"
    echo ""
else
    # Validate model configurations
    echo -e "${BLUE}[1/3] Validating model configurations...${NC}"
    if python3 "$PROJECT_ROOT/config/models/validate.py" --quiet 2>&1; then
        echo -e "${GREEN}  Model configs: OK${NC}"
    else
        echo -e "${RED}  Model configs: FAILED${NC}"
        FAILED=1
    fi

    # Validate layer configurations
    echo -e "${BLUE}[2/3] Validating layer configurations...${NC}"
    if python3 "$PROJECT_ROOT/config/layers/validate_layers.py" 2>&1; then
        echo -e "${GREEN}  Layer configs: OK${NC}"
    else
        echo -e "${RED}  Layer configs: FAILED${NC}"
        FAILED=1
    fi
fi

# Validate style configurations (doesn't require PyYAML)
echo -e "${BLUE}[3/3] Validating style configurations...${NC}"
if python3 "$PROJECT_ROOT/config/styles/validate_styles.py" 2>&1; then
    echo -e "${GREEN}  Style configs: OK${NC}"
else
    echo -e "${RED}  Style configs: FAILED${NC}"
    FAILED=1
fi

echo ""

if [[ $FAILED -eq 1 ]]; then
    echo -e "${RED}Pre-push validation failed!${NC}"
    echo ""
    echo "Fix the issues above before pushing."
    echo "To bypass this check (not recommended): git push --no-verify"
    exit 1
fi

echo -e "${GREEN}All validations passed!${NC}"
exit 0
