        # blob: in img-src needed for compliance page image rendering
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.redoc.ly https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
        # Permissions Policy - disable unused browser features
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        # Cross-Origin policies for Spectre mitigation
        add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;

        # Health check
        # Note: Must add security headers here since 'return' doesn't inherit from parent block
        location /health {
            access_log off;
            add_header Content-Type text/plain always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options SAMEORIGIN always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            return 200 "healthy\n";
        }

        # === BLOCKED ENDPOINTS ===
        # Block direct /metrics (Prometheus) but allow /api/metrics (dashboard)
        location = /metrics {
            return 404;
        }

        # Block sensitive files that should not be publicly accessible
        location = /Dockerfile {
            return 404;
        }
        location = /docker-compose.yml {
            return 404;
        }
        location = /.env {
            return 404;
        }
        location ~ /\. {
            return 404;
        }
        location = /robots.txt {
            add_header Content-Type text/plain;
            return 200 "User-agent: *\nAllow: /\nAllow: /wms\nAllow: /wmts\nAllow: /edr\nDisallow: /admin\nDisallow: /api/\nDisallow: /grafana/\n";
        }
        location = /favicon.ico {
            return 204;
            access_log off;
        }

        # === PUBLIC ENDPOINTS (rate limited, no auth) ===

        # Public splash page at root
        location = / {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard/splash.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /wms {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        location /wmts {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        location /edr {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_edr http://edr-api:8083;
            proxy_pass $upstream_edr;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }

        # === ADMIN ENDPOINTS (basic auth required) ===

        # WMS API admin endpoints (metrics, config, stats, etc.)
        location /api/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }

        # Load test dashboard
        location /loadtest {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Admin Dashboard
        location /admin {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard/index.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Dashboard static assets (CSS, JS, etc) - require auth
        location ~ ^/(style\.css|app\.js|admin\.|downloads\.|benchmarks\.|.*compliance.*|.*coverage.*) {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Fallback for other dashboard paths
        location / {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Grafana (subpath requires specific configuration)
        location /grafana/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            # Don't strip /grafana/ - Grafana handles it with SERVE_FROM_SUB_PATH
            set $upstream_grafana http://grafana:3000;
            proxy_pass $upstream_grafana;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # WebSocket support for live updates
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # Disable buffering for real-time updates
            proxy_buffering off;
        }
        
        # Grafana redirect (ensure trailing slash)
        location = /grafana {
            return 301 /grafana/;
        }

        location /minio/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            # Rewrite to strip /minio prefix before sending to MinIO
            rewrite ^/minio/(.*) /$1 break;
            set $upstream_minio http://minio:9001;
            proxy_pass $upstream_minio;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-NginX-Proxy true;
            
            # Required for MinIO console subpath
            proxy_set_header X-Minio-Console-Subpath /minio;
            
            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # Disable buffering for real-time updates
            proxy_buffering off;
