worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 2048;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # === SECURITY ===
    # Hide nginx version in error pages and Server header
    server_tokens off;

    # === PERFORMANCE ===
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # === RATE LIMITING ===
    # Zone for API rate limiting (uses $http_cf_connecting_ip if behind Cloudflare, else $remote_addr)
    map $http_cf_connecting_ip $real_client_ip {
        default $http_cf_connecting_ip;
        ""      $remote_addr;
    }
    limit_req_zone $real_client_ip zone=api:10m rate=__RATE_LIMIT_PER_MINUTE__r/m;
    limit_req_status 429;

    # === LOGGING ===
    log_format main '$real_client_ip - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" rt=$request_time';
    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    # === GZIP COMPRESSION ===
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript 
               application/xml application/xml+rss text/javascript image/svg+xml;

    # === DNS RESOLVER ===
    # Use Docker's embedded DNS server with short TTL to handle container restarts
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # === UPSTREAMS ===
    # Using variables in proxy_pass forces per-request DNS re-resolution via
    # Docker's internal resolver (127.0.0.11). This allows nginx to start even
    # when upstream containers aren't running yet, and handles container restarts
    # gracefully without needing to reload nginx.
    # Variable-based upstreams are set in each location block via: set $upstream_xxx

    # === MAIN SERVER (HTTP - used by Cloudflare Tunnel) ===
    # Cloudflare handles SSL termination, so tunnel traffic arrives on port 80
    server {
        listen 80;
        server_name __DOMAIN__ localhost;

        # === SECURITY HEADERS ===
        # HSTS - Force HTTPS for 1 year (Cloudflare also adds this, but defense in depth)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # Prevent MIME type sniffing
        add_header X-Content-Type-Options nosniff always;
        # Clickjacking protection
        add_header X-Frame-Options SAMEORIGIN always;
        # Referrer policy
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Content Security Policy - permissive for HTML pages with inline scripts
        # For API responses, CSP is less relevant but doesn't hurt
        # Includes CDNs for Leaflet (cdnjs.cloudflare.com, unpkg.com) used by admin dashboard
        # blob: in img-src needed for compliance page image rendering
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.redoc.ly https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
        # Permissions Policy - disable unused browser features
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        # Cross-Origin policies for Spectre mitigation
        add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;

        # Health check for nginx itself
        # Note: Must add security headers here since 'return' doesn't inherit from parent block
        location /health {
            access_log off;
            add_header Content-Type text/plain always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options SAMEORIGIN always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            return 200 "healthy\n";
        }

        # === BLOCKED ENDPOINTS ===
        # Block direct /metrics (Prometheus) but allow /api/metrics (dashboard)
        location = /metrics {
            return 404;
        }

        # Block sensitive files that should not be publicly accessible
        location = /Dockerfile {
            return 404;
        }
        location = /docker-compose.yml {
            return 404;
        }
        location = /.env {
            return 404;
        }
        location ~ /\. {
            return 404;
        }
        location = /robots.txt {
            add_header Content-Type text/plain;
            return 200 "User-agent: *\nAllow: /\nAllow: /wms\nAllow: /wmts\nAllow: /edr\nDisallow: /admin\nDisallow: /api/\nDisallow: /grafana/\n";
        }
        location = /favicon.ico {
            return 204;
            access_log off;
        }

        # === PUBLIC ENDPOINTS (rate limited, no auth) ===

        # Public splash page at root
        location = / {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard/splash.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # WMS API
        location /wms {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        # WMTS API
        location /wmts {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        # EDR API
        location /edr {
            limit_req zone=api burst=__RATE_LIMIT_BURST__ nodelay;
            set $upstream_edr http://edr-api:8083;
            proxy_pass $upstream_edr;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
        }

        # === ADMIN ENDPOINTS (basic auth required) ===

        # WMS API admin endpoints (metrics, config, stats, etc.)
        location /api/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
        }

        # Load test dashboard
        location /loadtest {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_wms http://wms-api:8080;
            proxy_pass $upstream_wms;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Admin Dashboard
        location /admin {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard/index.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Dashboard static assets (CSS, JS, etc) - require auth
        location ~ ^/(style\.css|app\.js|admin\.|downloads\.|benchmarks\.|.*compliance.*|.*coverage.*) {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Fallback for other dashboard paths
        location / {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_dashboard http://web-dashboard:8000;
            proxy_pass $upstream_dashboard;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Grafana (subpath requires specific configuration)
        location /grafana/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            # Don't strip /grafana/ - Grafana handles it with SERVE_FROM_SUB_PATH
            set $upstream_grafana http://grafana:3000;
            proxy_pass $upstream_grafana;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            
            # WebSocket support for live updates
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # Disable buffering for real-time updates
            proxy_buffering off;
        }
        
        # Grafana redirect (ensure trailing slash)
        location = /grafana {
            return 301 /grafana/;
        }

        # MinIO Console
        location /minio/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            # Rewrite to strip /minio prefix before sending to MinIO
            rewrite ^/minio/(.*) /$1 break;
            set $upstream_minio http://minio:9001;
            proxy_pass $upstream_minio;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-NginX-Proxy true;
            
            # Required for MinIO console subpath
            proxy_set_header X-Minio-Console-Subpath /minio;
            
            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            
            # Disable buffering for real-time updates
            proxy_buffering off;
            proxy_request_buffering off;
        }

        # MinIO Console redirect (ensure trailing slash)
        location = /minio {
            return 301 /minio/;
        }

        # Downloader Status
        location /downloader/ {
            auth_basic "Weather WMS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
            set $upstream_downloader http://downloader:8081;
            proxy_pass $upstream_downloader/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $real_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }

    # === HTTPS SERVER (for direct local access via IP) ===
    # This allows accessing the NUC directly on the local network via HTTPS
    server {
        listen 443 ssl http2;
        server_name __DOMAIN__ localhost;

        # TLS Configuration (Cloudflare Origin Certificate)
        ssl_certificate /etc/nginx/ssl/origin.cert;
        ssl_certificate_key /etc/nginx/ssl/origin.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        # === SECURITY HEADERS ===
        # HSTS - Force HTTPS for 1 year
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # Prevent MIME type sniffing
        add_header X-Content-Type-Options nosniff always;
        # Clickjacking protection
        add_header X-Frame-Options SAMEORIGIN always;
        # Referrer policy
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Content Security Policy - permissive for HTML pages with inline scripts
