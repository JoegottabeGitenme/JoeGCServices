{
  "uid": "trail-conditions-freshness",
  "title": "Trail Conditions Freshness",
  "description": "Is the trail-physics pipeline producing fresh data? Alert rules: deploy/prometheus/alerts.yml.",
  "tags": [
    "trails",
    "trail-physics",
    "freshness"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Freshness (green < 2h, yellow < 3h, red >= 3h -- the alert threshold)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Age of newest trail conditions",
      "description": "How old the hour is that ?conditions=latest currently reports. Normally ~1h or less.",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - trail_conditions_latest_valid_timestamp_seconds",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7200
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Time since trail-physics last processed an hour",
      "description": "When the worker last finished a forecast hour. Both this and the left panel high = worker problem; only the left = upstream HRRR ingest.",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - trail_physics_last_processed_timestamp_seconds",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7200
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "alertlist",
      "title": "Firing / pending trail alerts",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "alertName": "Trail",
        "showOptions": "current",
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": false,
          "error": true
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Age over time",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "time() - trail_conditions_latest_valid_timestamp_seconds",
          "legendFormat": "newest conditions",
          "refId": "A"
        },
        {
          "expr": "time() - trail_physics_last_processed_timestamp_seconds",
          "legendFormat": "worker last processed",
          "refId": "B"
        },
        {
          "expr": "vector(10800)",
          "legendFormat": "alert threshold (3h)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert threshold (3h)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}