{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JoegottabeGitenme/JoeGCServices/schemas/weather-model.schema.json",
  "title": "Weather Model Configuration",
  "description": "Configuration schema for weather data models (HRRR, GFS, MRMS, GOES, etc.)",
  "type": "object",
  "additionalProperties": true,
  "required": ["model", "source", "grid", "schedule", "retention", "parameters"],
  "properties": {
    "model": {
      "type": "object",
      "description": "Model identification and metadata",
      "required": ["id", "name", "enabled"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the model (e.g., 'hrrr', 'gfs')",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the model"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the model"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this model is enabled for ingestion"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "WMS/WMTS dimension configuration",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["forecast", "observation"],
          "description": "Dimension type: 'forecast' for NWP models, 'observation' for real-time data"
        },
        "run": {
          "type": "boolean",
          "description": "Enable RUN dimension (model initialization time)"
        },
        "forecast": {
          "type": "boolean",
          "description": "Enable FORECAST dimension (hours ahead from run time)"
        },
        "time": {
          "type": "boolean",
          "description": "Enable TIME dimension (observation timestamp)"
        },
        "elevation": {
          "type": "boolean",
          "description": "Enable ELEVATION dimension (vertical levels)"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Data source configuration",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["aws_s3", "aws_s3_grib2", "aws_s3_goes", "http", "local"],
          "description": "Source type for data retrieval"
        },
        "bucket": {
          "type": "string",
          "description": "S3 bucket name"
        },
        "prefix_template": {
          "type": "string",
          "description": "Template for S3 prefix (supports {date}, {cycle}, etc.)"
        },
        "path_pattern": {
          "type": "string",
          "description": "Path pattern for file discovery"
        },
        "file_pattern": {
          "type": "string",
          "description": "File naming pattern (supports template variables)"
        },
        "region": {
          "type": "string",
          "description": "AWS region"
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "bzip2"],
          "description": "File compression type"
        },
        "product": {
          "type": "string",
          "description": "Product identifier (for GOES data)"
        },
        "bands": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Band numbers to ingest (for satellite data)"
        }
      }
    },
    "grid": {
      "type": "object",
      "description": "Grid/projection configuration",
      "required": ["projection", "resolution", "bbox"],
      "additionalProperties": true,
      "properties": {
        "projection": {
          "type": "string",
          "enum": ["lambert_conformal", "geographic", "latlon", "geostationary"],
          "description": "Grid projection type"
        },
        "resolution": {
          "type": "string",
          "description": "Grid resolution (e.g., '3km', '0.25deg')"
        },
        "bbox": {
          "type": "object",
          "description": "Bounding box in native coordinates",
          "required": ["min_lon", "min_lat", "max_lon", "max_lat"],
          "properties": {
            "min_lon": { "type": "number" },
            "min_lat": { "type": "number" },
            "max_lon": { "type": "number" },
            "max_lat": { "type": "number" }
          }
        },
        "lon_convention": {
          "type": "string",
          "enum": ["0_to_360", "-180_to_180"],
          "description": "Longitude convention"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          }
        },
        "projection_params": {
          "type": "object",
          "description": "Projection-specific parameters",
          "additionalProperties": true,
          "properties": {
            "lat1": { "type": "number" },
            "lon1": { "type": "number" },
            "lov": { "type": "number", "description": "Central meridian" },
            "latin1": { "type": "number", "description": "Standard parallel 1" },
            "latin2": { "type": "number", "description": "Standard parallel 2" },
            "dx": { "type": "number", "description": "X grid spacing (meters)" },
            "dy": { "type": "number", "description": "Y grid spacing (meters)" },
            "nx": { "type": "integer", "description": "Number of X grid points" },
            "ny": { "type": "integer", "description": "Number of Y grid points" },
            "satellite_longitude": { "type": "number" },
            "satellite_height": { "type": "number" },
            "semi_major_axis": { "type": "number" },
            "semi_minor_axis": { "type": "number" }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "description": "Data availability and polling schedule",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["forecast", "observation"],
          "description": "Schedule type"
        },
        "cycles": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 23 },
          "description": "Model run cycles (UTC hours)"
        },
        "forecast_hours": {
          "type": "object",
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer" },
            "step": { "type": "integer", "minimum": 1 }
          }
        },
        "poll_interval_secs": {
          "type": "integer",
          "minimum": 60,
          "description": "How often to poll for new data (seconds)"
        },
        "delay_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "Expected delay before data becomes available"
        }
      }
    },
    "retention": {
      "type": "object",
      "description": "Data retention settings",
      "additionalProperties": true,
      "properties": {
        "hours": {
          "type": "integer",
          "minimum": 1,
          "description": "How long to keep data (hours)"
        },
        "keep_latest_runs": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of recent runs to keep"
        },
        "keep_latest_observations": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of recent observations to keep"
        }
      }
    },
    "precaching": {
      "type": "object",
      "description": "Cache warming configuration",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable proactive cache warming"
        },
        "keep_recent": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of recent forecasts/observations to keep cached"
        },
        "keep_recent_cycles": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of recent model cycles to cache"
        },
        "forecast_hours": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Specific forecast hours to cache"
        },
        "warm_on_ingest": {
          "type": "boolean",
          "description": "Warm cache immediately after ingestion"
        },
        "poll_interval_secs": {
          "type": "integer",
          "minimum": 30,
          "description": "Background poll interval for cache warming"
        },
        "parameters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Parameters to precache"
        }
      }
    },
    "parameters": {
      "type": "array",
      "description": "GRIB2 parameter definitions",
      "items": {
        "type": "object",
        "required": ["name", "description", "levels", "units"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter short name (e.g., 'TMP', 'UGRD')"
          },
          "description": {
            "type": "string",
            "description": "Human-readable parameter description"
          },
          "grib2": {
            "type": "object",
            "description": "GRIB2 parameter identification",
            "properties": {
              "discipline": { "type": "integer", "minimum": 0 },
              "category": { "type": "integer", "minimum": 0 },
              "number": { "type": "integer", "minimum": 0 }
            }
          },
          "product": {
            "type": "string",
            "description": "Product identifier (for MRMS)"
          },
          "band": {
            "type": "integer",
            "description": "Satellite band number (for GOES)"
          },
          "downsample": {
            "type": "string",
            "enum": ["mean", "max", "min", "nearest"],
            "description": "Downsampling method for lower zoom levels"
          },
          "levels": {
            "type": "array",
            "description": "Available vertical levels",
            "items": {
              "type": "object",
              "required": ["type", "level_code"],
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "surface", "height_above_ground", "isobaric", "mean_sea_level",
                    "entire_atmosphere", "cloud_layer", "height_above_msl",
                    "cloud_top", "top_of_atmosphere"
                  ],
                  "description": "Level type"
                },
                "level_code": {
                  "type": "integer",
                  "description": "GRIB2 level type code (Table 4.5)"
                },
                "value": {
                  "type": "number",
                  "description": "Level value (e.g., pressure in Pa, height in m)"
                },
                "values": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "description": "Multiple level values"
                },
                "display": {
                  "type": "string",
                  "description": "Display string for the level"
                },
                "display_template": {
                  "type": "string",
                  "description": "Template for level display (e.g., '{value_mb} mb')"
                }
              }
            }
          },
          "style": {
            "type": "string",
            "description": "Default rendering style"
          },
          "units": {
            "type": "string",
            "description": "Native data units"
          },
          "display_units": {
            "type": "string",
            "description": "Display units (after conversion)"
          },
          "conversion": {
            "type": "string",
            "description": "Unit conversion function (e.g., 'K_to_C')"
          },
          "accumulation": {
            "type": "boolean",
            "description": "Whether this is an accumulation parameter"
          },
          "valid_range": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2,
            "description": "Valid data range [min, max]"
          }
        }
      }
    },
    "composites": {
      "type": "array",
      "description": "Composite layer definitions (derived from multiple parameters)",
      "items": {
        "type": "object",
        "required": ["name", "requires"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Composite layer name"
          },
          "description": {
            "type": "string",
            "description": "Composite layer description"
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required source parameters"
          },
          "renderer": {
            "type": "string",
            "description": "Renderer to use for this composite"
          },
          "style": {
            "type": "string",
            "description": "Default style for the composite"
          }
        }
      }
    }
  }
}
