{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JoegottabeGitenme/JoeGCServices/schemas/helm-values.schema.json",
  "title": "Weather WMS Helm Values",
  "description": "Configuration schema for weather-wms Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings applied to all components",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Global Docker image registry"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Global image pull secrets"
        }
      }
    },
    "api": {
      "type": "object",
      "description": "WMS/WMTS API service configuration",
      "additionalProperties": true,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of API replicas"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "autoscaling": {
          "$ref": "#/$defs/autoscaling"
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "description": "Web dashboard configuration",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the dashboard"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "ingester": {
      "type": "object",
      "description": "Data ingester configuration",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the ingester"
        },
        "mode": {
          "type": "string",
          "enum": ["deployment", "cronjob"],
          "description": "Run mode: deployment (continuous) or cronjob (scheduled)"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "schedule": {
          "type": "string",
          "description": "Cron schedule (if mode: cronjob)"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "models": {
          "type": "object",
          "description": "Per-model ingestion settings",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "pollInterval": { "type": "integer", "minimum": 60 }
            }
          }
        }
      }
    },
    "downloader": {
      "type": "object",
      "description": "Data downloader configuration",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": ["deployment", "cronjob"]
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "schedule": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "downloads": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            },
            "state": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "redis": {
      "type": "object",
      "description": "Redis configuration (Bitnami subchart)",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": {
          "type": "string",
          "enum": ["standalone", "replication"]
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "password": { "type": "string" }
          }
        },
        "master": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" }
              }
            }
          }
        },
        "replica": {
          "type": "object",
          "properties": {
            "replicaCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "description": "PostgreSQL configuration (Bitnami subchart)",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "database": { "type": "string" }
          }
        },
        "primary": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "minio": {
      "type": "object",
      "description": "MinIO configuration (Bitnami subchart)",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["standalone", "distributed"]
        },
        "auth": {
          "type": "object",
          "properties": {
            "rootUser": { "type": "string" },
            "rootPassword": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" }
          }
        },
        "defaultBuckets": {
          "type": "string",
          "description": "Comma-separated list of buckets to create"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Shared configuration for all services",
      "additionalProperties": true,
      "properties": {
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "region": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "poolSize": { "type": "string" }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "url": { "type": "string" }
          }
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": { "type": "string" },
            "backtrace": { "type": "string" }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "workerThreads": { "type": "string" }
          }
        },
        "cache": {
          "type": "object",
          "properties": {
            "l1": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" },
                "ttlSecs": { "type": "string" }
              }
            }
          }
        },
        "prefetch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "rings": { "type": "string" },
            "minZoom": { "type": "string" },
            "maxZoom": { "type": "string" }
          }
        },
        "cacheWarming": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxZoom": { "type": "string" },
            "hours": { "type": "string" },
            "layers": { "type": "string" },
            "concurrency": { "type": "string" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": { "type": "string" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fsGroup": { "type": "integer" }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer" }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Docker image repository"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "description": "Kubernetes service type"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
