{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JoegottabeGitenme/JoeGCServices/schemas/edr-locations.schema.json",
  "title": "EDR Named Locations Configuration",
  "description": "Configuration schema for pre-defined geographic locations for EDR queries",
  "type": "object",
  "additionalProperties": true,
  "required": ["locations"],
  "properties": {
    "locations": {
      "type": "array",
      "description": "Named location definitions",
      "items": {
        "type": "object",
        "required": ["id", "name", "coords"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique location identifier (e.g., ICAO code, city abbreviation)",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "description": "Full location name"
          },
          "description": {
            "type": "string",
            "description": "Additional location description"
          },
          "coords": {
            "type": "array",
            "description": "Coordinates as [longitude, latitude] in CRS:84 (WGS84)",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "properties": {
            "type": "object",
            "description": "Additional location properties",
            "additionalProperties": true,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["airport", "city", "station", "buoy", "other"],
                "description": "Location type"
              },
              "country": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 country code",
                "pattern": "^[A-Z]{2}$"
              },
              "elevation_m": {
                "type": "number",
                "description": "Elevation in meters"
              },
              "wmo_id": {
                "type": "string",
                "description": "WMO station identifier"
              },
              "icao": {
                "type": "string",
                "description": "ICAO airport code",
                "pattern": "^[A-Z]{4}$"
              }
            }
          }
        }
      }
    },
    "precaching": {
      "type": "object",
      "description": "Pre-caching configuration for named locations",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable location-based pre-caching"
        },
        "locations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Location IDs to pre-cache"
        },
        "parameters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Parameters to pre-cache for these locations"
        },
        "refresh_interval_secs": {
          "type": "integer",
          "minimum": 60,
          "description": "How often to refresh cached data"
        }
      }
    }
  }
}
