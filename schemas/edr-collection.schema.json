{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JoegottabeGitenme/JoeGCServices/schemas/edr-collection.schema.json",
  "title": "OGC EDR Collection Configuration",
  "description": "Configuration schema for OGC Environmental Data Retrieval (EDR) API collections",
  "type": "object",
  "additionalProperties": true,
  "required": ["model", "collections"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model ID this EDR configuration belongs to",
      "pattern": "^[a-z0-9_-]+$"
    },
    "collections": {
      "type": "array",
      "description": "EDR collection definitions",
      "items": {
        "type": "object",
        "required": ["id", "title", "parameters", "run_mode"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique collection identifier",
            "pattern": "^[a-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "description": "Human-readable collection title"
          },
          "description": {
            "type": "string",
            "description": "Detailed collection description"
          },
          "level_filter": {
            "type": "object",
            "description": "Filter for vertical levels included in this collection",
            "properties": {
              "level_type": {
                "type": "string",
                "enum": [
                  "surface", "height_above_ground", "isobaric", "mean_sea_level",
                  "entire_atmosphere", "cloud_layer", "height_above_msl", "top_of_atmosphere"
                ],
                "description": "Type of vertical level"
              },
              "level_code": {
                "type": "integer",
                "description": "GRIB2 level type code"
              },
              "level_codes": {
                "type": "array",
                "items": { "type": "integer" },
                "description": "Multiple GRIB2 level type codes"
              }
            }
          },
          "parameters": {
            "type": "array",
            "description": "Parameters available in this collection",
            "items": {
              "type": "object",
              "required": ["name", "levels"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Parameter name"
                },
                "levels": {
                  "type": "array",
                  "description": "Available levels for this parameter",
                  "items": {
                    "oneOf": [
                      { "type": "integer" },
                      { "type": "string" }
                    ]
                  }
                }
              }
            }
          },
          "run_mode": {
            "type": "string",
            "enum": ["instances", "latest"],
            "description": "Access mode: 'instances' for all runs, 'latest' for most recent only"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "EDR API settings for this model",
      "additionalProperties": true,
      "properties": {
        "output_formats": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported output formats (MIME types)"
        },
        "default_crs": {
          "type": "string",
          "description": "Default coordinate reference system",
          "examples": ["CRS:84", "EPSG:4326"]
        },
        "supported_crs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported coordinate reference systems"
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "Response size and query limits",
      "additionalProperties": true,
      "properties": {
        "max_parameters_per_request": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of parameters per request"
        },
        "max_time_steps": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of time steps in response"
        },
        "max_vertical_levels": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of vertical levels in response"
        },
        "max_response_size_mb": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum response size in megabytes"
        },
        "max_area_sq_degrees": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum area for area queries (square degrees)"
        },
        "max_radius_km": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum radius for radius queries (kilometers)"
        }
      }
    }
  }
}
