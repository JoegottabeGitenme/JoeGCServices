{
  "version": "1.0",
  "metadata": {
    "name": "Sea Ice Styles",
    "description": "Styles for sea ice concentration and thickness"
  },
  "styles": {
    "concentration": {
      "default": true,
      "name": "Ice Concentration",
      "description": "Sea ice concentration from open water to pack ice",
      "type": "gradient",
      "units": "fraction",
      "range": {
        "min": 0,
        "max": 1
      },
      "stops": [
        { "value": 0, "color": "#FFFFFF00", "label": "Open water" },
        { "value": 0.1, "color": "#E0F0FF", "label": "10%" },
        { "value": 0.2, "color": "#B0DCFF", "label": "20%" },
        { "value": 0.3, "color": "#80C8FF", "label": "30%" },
        { "value": 0.4, "color": "#50B4FF", "label": "40%" },
        { "value": 0.5, "color": "#30A0F0", "label": "50%" },
        { "value": 0.6, "color": "#2088D0", "label": "60%" },
        { "value": 0.7, "color": "#1070B0", "label": "70%" },
        { "value": 0.8, "color": "#005890", "label": "80%" },
        { "value": 0.9, "color": "#003870", "label": "90%" },
        { "value": 1.0, "color": "#E8E8F0", "label": "100%" }
      ],
      "interpolation": "linear",
      "out_of_range": "clamp",
      "legend": {
        "title": "Sea Ice Concentration (%)",
        "labels": ["0", "20", "40", "60", "80", "100"]
      }
    },
    "thickness": {
      "name": "Ice Thickness",
      "description": "Sea ice thickness in meters",
      "type": "gradient",
      "units": "m",
      "range": {
        "min": 0,
        "max": 5
      },
      "stops": [
        { "value": 0, "color": "#FFFFFF00", "label": "0 m" },
        { "value": 0.1, "color": "#E0F0FF", "label": "0.1 m" },
        { "value": 0.3, "color": "#80C8FF", "label": "0.3 m" },
        { "value": 0.5, "color": "#30A0F0", "label": "0.5 m" },
        { "value": 1.0, "color": "#2070C0", "label": "1 m" },
        { "value": 1.5, "color": "#1050A0", "label": "1.5 m" },
        { "value": 2.0, "color": "#003880", "label": "2 m" },
        { "value": 3.0, "color": "#002060", "label": "3 m" },
        { "value": 5.0, "color": "#001040", "label": "5+ m" }
      ],
      "interpolation": "linear",
      "out_of_range": "extend",
      "legend": {
        "title": "Ice Thickness (m)",
        "labels": ["0", "0.5", "1", "2", "3", "5"]
      }
    }
  }
}
