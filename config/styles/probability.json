{
  "version": "1.0",
  "metadata": {
    "name": "Probability Styles",
    "description": "Styles for probability parameters (PoP, etc.)"
  },
  "styles": {
    "gradient": {
      "default": true,
      "name": "Probability of Precipitation",
      "description": "Probability of precipitation from 0-100%",
      "type": "gradient",
      "units": "%",
      "range": {
        "min": 0,
        "max": 100
      },
      "stops": [
        { "value": 0, "color": "#FFFFFF00", "label": "0%" },
        { "value": 5, "color": "#F0FFF0", "label": "5%" },
        { "value": 10, "color": "#E0F5E0", "label": "10%" },
        { "value": 20, "color": "#C0E8C0", "label": "20%" },
        { "value": 30, "color": "#98DC98", "label": "30%" },
        { "value": 40, "color": "#70D070", "label": "40%" },
        { "value": 50, "color": "#50C050", "label": "50%" },
        { "value": 60, "color": "#40B040", "label": "60%" },
        { "value": 70, "color": "#30A030", "label": "70%" },
        { "value": 80, "color": "#208820", "label": "80%" },
        { "value": 90, "color": "#107010", "label": "90%" },
        { "value": 100, "color": "#005800", "label": "100%" }
      ],
      "interpolation": "linear",
      "out_of_range": "clamp",
      "legend": {
        "title": "Probability of Precipitation (%)",
        "labels": ["0%", "25%", "50%", "75%", "100%"]
      }
    },
    "categorical": {
      "name": "PoP Categories",
      "description": "Precipitation probability in NWS-style categories (green)",
      "type": "gradient",
      "units": "%",
      "range": {
        "min": 0,
        "max": 100
      },
      "stops": [
        { "value": 0, "color": "#FFFFFF00", "label": "None (0%)" },
        { "value": 10, "color": "#E0F5E0", "label": "Slight Chance (10-20%)" },
        { "value": 20, "color": "#C0E8C0", "label": "Slight Chance" },
        { "value": 30, "color": "#90D890", "label": "Chance (30-50%)" },
        { "value": 50, "color": "#50C050", "label": "Chance" },
        { "value": 60, "color": "#40B040", "label": "Likely (60-70%)" },
        { "value": 70, "color": "#30A030", "label": "Likely" },
        { "value": 80, "color": "#208020", "label": "Very Likely (80-100%)" },
        { "value": 100, "color": "#005800", "label": "Definite" }
      ],
      "interpolation": "linear",
      "out_of_range": "clamp",
      "legend": {
        "title": "Precipitation Probability",
        "labels": ["None", "Slight Chance", "Chance", "Likely", "Definite"]
      }
    }
  }
}
