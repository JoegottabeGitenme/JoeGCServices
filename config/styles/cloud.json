{
  "version": "1.0",
  "metadata": {
    "name": "Cloud Cover Styles",
    "description": "Styles for cloud cover visualization"
  },
  "styles": {
    "default": {
      "default": true,
      "name": "Cloud Cover",
      "description": "Cloud cover percentage from clear to overcast",
      "type": "gradient",
      "units": "%",
      "range": {
        "min": 0,
        "max": 100
      },
      "stops": [
        { "value": 0, "color": "#87CEEB", "label": "Clear" },
        { "value": 10, "color": "#9DD5ED", "label": "10%" },
        { "value": 20, "color": "#A8D4E6", "label": "20%" },
        { "value": 30, "color": "#B0D0DC", "label": "30%" },
        { "value": 40, "color": "#B8CCD2", "label": "40%" },
        { "value": 50, "color": "#BFBFBF", "label": "50%" },
        { "value": 60, "color": "#A8A8A8", "label": "60%" },
        { "value": 70, "color": "#909090", "label": "70%" },
        { "value": 80, "color": "#787878", "label": "80%" },
        { "value": 90, "color": "#606060", "label": "90%" },
        { "value": 100, "color": "#505050", "label": "Overcast" }
      ],
      "interpolation": "linear",
      "out_of_range": "clamp",
      "legend": {
        "title": "Cloud Cover (%)",
        "labels": ["Clear", "25%", "50%", "75%", "Overcast"]
      }
    }
  }
}
