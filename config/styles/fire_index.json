{
  "version": "1.0",
  "metadata": {
    "name": "Fire Weather Index Styles",
    "description": "Styles for Fosberg Fire Weather Index"
  },
  "styles": {
    "gradient": {
      "default": true,
      "name": "Fosberg Fire Weather Index",
      "description": "Fire weather potential index (0-100 scale)",
      "type": "gradient",
      "units": "index",
      "range": {
        "min": 0,
        "max": 100
      },
      "stops": [
        { "value": 0, "color": "#00AA00", "label": "0 (Low)" },
        { "value": 25, "color": "#66CC00", "label": "25" },
        { "value": 40, "color": "#CCCC00", "label": "40 (Moderate)" },
        { "value": 50, "color": "#FFCC00", "label": "50" },
        { "value": 60, "color": "#FF9900", "label": "60 (High)" },
        { "value": 70, "color": "#FF6600", "label": "70" },
        { "value": 80, "color": "#FF3300", "label": "80 (Very High)" },
        { "value": 90, "color": "#CC0000", "label": "90" },
        { "value": 100, "color": "#800000", "label": "100 (Extreme)" }
      ],
      "interpolation": "linear",
      "out_of_range": "clamp",
      "legend": {
        "title": "Fire Weather Index",
        "labels": ["Low", "Moderate", "High", "Very High", "Extreme"],
        "description": "Low (<25), Moderate (25-50), High (50-75), Very High (75-90), Extreme (>90)"
      }
    }
  }
}
