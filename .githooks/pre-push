#!/bin/bash
# Pre-push hook for weather-wms
# Runs formatting checks, linting, and tests before allowing pushes
# This ensures code quality without slowing down individual commits

set -e

echo "Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
fi

# 1. Check formatting (do NOT auto-fix during push - causes commit divergence)
echo "  Checking formatting..."
if ! cargo fmt --check > /dev/null 2>&1; then
    echo -e "${RED}Formatting issues found!${NC}"
    echo -e "Run '${YELLOW}cargo fmt${NC}' to fix formatting, then commit and push again."
    exit 1
fi
echo -e "  ${GREEN}Formatting OK${NC}"

# 2. Check for trailing whitespace in Rust files (do NOT auto-fix during push)
echo "  Checking for trailing whitespace..."
WHITESPACE_FILES=""
RS_FILES=$(find . -name "*.rs" -not -path "./target/*" 2>/dev/null || true)
for file in $RS_FILES; do
    if grep -qE "[[:space:]]$" "$file" 2>/dev/null; then
        WHITESPACE_FILES="${WHITESPACE_FILES} $file"
    fi
done

if [ -n "$WHITESPACE_FILES" ]; then
    echo -e "${RED}Trailing whitespace found in:${NC}"
    for file in $WHITESPACE_FILES; do
        echo -e "  ${YELLOW}$file${NC}"
    done
    echo -e "Run the following to fix:"
    echo -e "  ${YELLOW}sed -i 's/[[:space:]]*\$//' <file>${NC}"
    echo -e "Then commit and push again."
    exit 1
fi
echo -e "  ${GREEN}No trailing whitespace${NC}"

# 3. Validate config files
echo "  Validating model configs..."
if ! python3 config/models/validate.py -q > /dev/null 2>&1; then
    echo -e "${RED}Model config validation failed!${NC}"
    python3 config/models/validate.py
    exit 1
fi
echo -e "  ${GREEN}Model configs OK${NC}"

echo "  Validating layer configs..."
if ! python3 config/layers/validate_layers.py > /dev/null 2>&1; then
    echo -e "${RED}Layer config validation failed!${NC}"
    python3 config/layers/validate_layers.py
    exit 1
fi
echo -e "  ${GREEN}Layer configs OK${NC}"

echo "  Validating style configs..."
if ! python3 config/styles/validate_styles.py > /dev/null 2>&1; then
    echo -e "${RED}Style config validation failed!${NC}"
    python3 config/styles/validate_styles.py
    exit 1
fi
echo -e "  ${GREEN}Style configs OK${NC}"

echo "  Validating EDR configs..."
if ! python3 config/edr/validate_edr.py -q > /dev/null 2>&1; then
    echo -e "${RED}EDR config validation failed!${NC}"
    python3 config/edr/validate_edr.py
    exit 1
fi
echo -e "  ${GREEN}EDR configs OK${NC}"

# 4. Cargo check
echo "  Running cargo check..."
if ! cargo check --workspace --quiet 2>/dev/null; then
    echo -e "${RED}Cargo check failed!${NC}"
    echo "Fix compilation errors before pushing."
    cargo check --workspace 2>&1 | tail -30
    exit 1
fi
echo -e "  ${GREEN}Cargo check OK${NC}"

# 5. Run tests
echo "  Running tests..."
if ! cargo test --workspace --quiet 2>/dev/null; then
    echo -e "${RED}Tests failed!${NC}"
    echo "Fix failing tests before pushing."
    exit 1
fi
echo -e "  ${GREEN}Tests OK${NC}"

# 6. Code coverage checks for critical crates
# Set COVERAGE_CHECK=strict to fail on threshold violations
# Set COVERAGE_CHECK=skip to skip coverage entirely
COVERAGE_CHECK="${COVERAGE_CHECK:-warn}"

if [ "$COVERAGE_CHECK" != "skip" ]; then
    # Check if cargo-tarpaulin is installed
    if command -v cargo-tarpaulin &> /dev/null; then
        echo "  Checking code coverage for critical crates..."
        
        # Coverage thresholds (adjust as coverage improves)
        RENDERER_THRESHOLD=70
        PROJECTION_THRESHOLD=90
        STORAGE_THRESHOLD=40
        WMS_API_THRESHOLD=30
        EDR_API_THRESHOLD=35
        
        COVERAGE_FAILED=0
        
        # Function to check coverage for a package
        # Calculates coverage for just the crate's own files, not dependencies
        check_coverage() {
            local package=$1
            local threshold=$2
            local output
            local total_covered=0
            local total_lines=0
            local coverage
            
            # Determine the crate path based on package name
            local crate_path
            case "$package" in
                "renderer") crate_path="crates/renderer/src" ;;
                "projection") crate_path="crates/projection/src" ;;
                "storage") crate_path="crates/storage/src" ;;
                "wms-api") crate_path="services/wms-api/src" ;;
                "edr-api") crate_path="services/edr-api/src" ;;
                *) crate_path="crates/$package/src" ;;
            esac
            
            output=$(cargo tarpaulin --package "$package" --skip-clean --out Stdout 2>&1)
            
            # Parse per-file coverage lines for just the target crate
            # Format: "|| path/to/file.rs: 123/456 +0.00%"
            while IFS= read -r line; do
                if [[ "$line" =~ \|\|\ ${crate_path}/.*:\ ([0-9]+)/([0-9]+) ]]; then
                    local covered="${BASH_REMATCH[1]}"
                    local total="${BASH_REMATCH[2]}"
                    total_covered=$((total_covered + covered))
                    total_lines=$((total_lines + total))
                fi
            done <<< "$output"
            
            if [ "$total_lines" -eq 0 ]; then
                echo -e "    ${YELLOW}$package: No coverage data found${NC}"
                return 0
            fi
            
            # Calculate percentage (integer math, multiply first to avoid truncation)
            local coverage_pct=$((total_covered * 100 / total_lines))
            
            if [ "$coverage_pct" -lt "$threshold" ]; then
                echo -e "    ${RED}$package: ${coverage_pct}% (${total_covered}/${total_lines}) < ${threshold}% threshold${NC}"
                return 1
            else
                echo -e "    ${GREEN}$package: ${coverage_pct}% (${total_covered}/${total_lines}) >= ${threshold}% threshold${NC}"
                return 0
            fi
        }
        
        # Check renderer (highest priority - already at 75%)
        if ! check_coverage "renderer" $RENDERER_THRESHOLD; then
            COVERAGE_FAILED=1
        fi
        
        # Check projection (critical for coordinate transforms - at 95%+)
        if ! check_coverage "projection" $PROJECTION_THRESHOLD; then
            COVERAGE_FAILED=1
        fi
        
        # Note: storage, wms-api, edr-api checks disabled until coverage improves
        # Uncomment these as you improve coverage:
        #
        # if ! check_coverage "storage" $STORAGE_THRESHOLD; then
        #     COVERAGE_FAILED=1
        # fi
        #
        # if ! check_coverage "wms-api" $WMS_API_THRESHOLD; then
        #     COVERAGE_FAILED=1
        # fi
        #
        # if ! check_coverage "edr-api" $EDR_API_THRESHOLD; then
        #     COVERAGE_FAILED=1
        # fi
        
        if [ $COVERAGE_FAILED -eq 1 ]; then
            if [ "$COVERAGE_CHECK" = "strict" ]; then
                echo -e "${RED}Coverage check failed!${NC}"
                echo "Improve test coverage or set COVERAGE_CHECK=warn to continue."
                exit 1
            else
                echo -e "${YELLOW}Coverage below threshold (warning only)${NC}"
                echo "Set COVERAGE_CHECK=strict to enforce thresholds."
            fi
        else
            echo -e "  ${GREEN}Coverage OK${NC}"
        fi
    else
        echo -e "  ${YELLOW}Skipping coverage (cargo-tarpaulin not installed)${NC}"
        echo "  Install with: cargo install cargo-tarpaulin"
    fi
fi

echo -e "${GREEN}All pre-push checks passed!${NC}"
exit 0
