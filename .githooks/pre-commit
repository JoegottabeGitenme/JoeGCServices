#!/bin/bash
# Pre-commit hook for weather-wms
# Auto-formats staged Rust code before committing

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Only run if Rust files are staged
STAGED_RS_FILES=$(git diff --cached --name-only -- '*.rs')
if [ -z "$STAGED_RS_FILES" ]; then
    exit 0
fi

# Check if formatting is needed
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo -e "${YELLOW}Formatting Rust code...${NC}"
    cargo fmt --all

    # Re-stage the formatted files
    echo "$STAGED_RS_FILES" | xargs git add

    echo -e "${GREEN}Formatted and staged${NC}"
else
    echo -e "${GREEN}Formatting OK${NC}"
fi
